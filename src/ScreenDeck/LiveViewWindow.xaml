<Window x:Class="ScreenDeck.LiveViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenDeck 확대 보기" Icon="ScreenDeck.ico" Width="1280" Height="760"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        ShowActivated="False" ShowInTaskbar="False">

  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="14,8">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="MonitorText" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock x:Name="FpsText" Foreground="{StaticResource FgDim}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="ControlCheck" IsChecked="True" Foreground="{StaticResource Fg}" VerticalAlignment="Center"
                    Margin="0,0,16,0" Content="마우스·키보드 조작"/>
          <Button Content="닫기" Click="Close_Click" Foreground="{StaticResource Fg}" Background="{StaticResource PanelHi}"
                  BorderBrush="{StaticResource Border}" Padding="14,4" Cursor="Hand"/>
        </StackPanel>
        <TextBlock x:Name="HintText" DockPanel.Dock="Right" Foreground="{StaticResource FgDim}" VerticalAlignment="Center"
                   Margin="0,0,20,0"
                   Text="클릭·드래그·휠이 해당 모니터로 전달됩니다 · 클릭한 프로그램에 바로 키보드 입력"/>
      </DockPanel>
    </Border>

    <!-- Live screen -->
    <Grid x:Name="Surface" Background="#0E1014" ClipToBounds="True">
      <Image x:Name="Screen" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"
             MouseDown="Screen_MouseDown" MouseUp="Screen_MouseUp" MouseWheel="Screen_MouseWheel"/>
      <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
    </Grid>
  </DockPanel>
</Window>
