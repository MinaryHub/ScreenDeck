    <SolidColorBrush x:Key="PanelHi" Color="#2A303B"/>
    <SolidColorBrush x:Key="Border" Color="#343B48"/>
    <SolidColorBrush x:Key="Fg" Color="#E6E9EF"/>
    <SolidColorBrush x:Key="FgDim" Color="#8B93A3"/>
